# Auth Proxy Configuration
# Copy to config.yaml and fill in your values.

server:
  host: "0.0.0.0"
  port: 8443

api:
  # Shared secret between the AI agent and this proxy.
  # Can also be set via AUTH_PROXY_TOKEN env var (takes precedence).
  auth_token: "change-me-to-a-long-random-string"

telegram:
  # Bot token from @BotFather on Telegram.
  # Can also be set via AUTH_PROXY_TELEGRAM env var (takes precedence).
  bot_token: "YOUR_BOT_TOKEN_HERE"

  # List of Telegram user IDs allowed to approve/deny requests.
  # Get your user ID by messaging @userinfobot on Telegram.
  allowed_user_ids:
    - 123456789

approval:
  # Mode: "telegram" (send via Telegram), "console" (stdin), "auto" (no approval)
  mode: "telegram"
  # Blocking-client wait timeout (seconds). This is intentionally short-ish:
  # async requests keep waiting in the durable queue after HTTP returns.
  timeout: 300
  # Durable approval window (seconds). Default: 4 hours.
  request_ttl: 14400
  # Max time a request may remain running without an update before it is failed.
  running_timeout: 3600
  # Optional SQLite path. Default: ./auth-proxy-requests.sqlite3
  db_path: ""

services:
  # ── Git / GitHub ──────────────────────────────────────────────────────
  git:
    enabled: true
    # Path to the SSH private key that has access to GitHub.
    # The proxy holds this key — it never leaves this machine.
    ssh_key_path: "~/.ssh/id_ed25519"
    # Timeout for individual git commands (seconds)
    timeout: 120

  # ── GitHub API ────────────────────────────────────────────────────────
  github:
    enabled: true
    # GitHub Personal Access Token (classic or fine-grained) with scopes:
    #   - repo (full control of private repos)
    #   - public_repo (for public repo operations)
    # The proxy holds this token — the client never sees it.
    token: "github_pat_..."
    # Timeout for individual API calls (seconds)
    timeout: 30

  # ── Sudo over SSH ─────────────────────────────────────────────────────
  sudo:
    enabled: true
    # SSH target for approved sudo commands. Request data cannot override this.
    host: "agent-vm.example.internal"
    user: "openclaw"
    port: 22
    # Dedicated private key on the gateway; required. Do not reuse personal keys.
    # Public key must be authorized on the target.
    ssh_key_path: "~/.ssh/id_ed25519_agent_vm"
    # Prefer "yes" with a pre-pinned known_hosts entry. "accept-new" is available
    # for lower-touch setup but trusts the first connection.
    strict_host_key_checking: "yes"
    # Basenames denied even after approval because they commonly spawn shells.
    denied_commands: ["sh", "bash", "zsh", "vi", "vim", "nano", "find", "xargs", "env"]
    # Timeout for the remote sudo command (seconds)
    timeout: 300

  # ── Google Calendar (future) ──────────────────────────────────────────
  # calendar:
  #   enabled: false
  #   sa_key_path: "~/.auth-proxy/secrets/calendar-sa-key.json"
  #   calendar_id: "your-calendar-id@group.calendar.google.com"
